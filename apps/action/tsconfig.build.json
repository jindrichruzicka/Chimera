{
    // Composite `tsc -b` build for the @chimera-engine/action consumer app.
    // Follows the split-tsconfig dist pattern of the engine packages and of
    // apps/tactics — composite emit under ./dist (JS + .d.ts + maps), test files
    // excluded.
    //
    // JSX compiles to runnable JS via the React 19 automatic runtime
    // ("react-jsx"), UNLIKE the editor config tsconfig.json which keeps
    // jsx:"preserve". css-modules.d.ts supplies the *.module.css ambient.
    //
    // LAYER 3: a consumer APP — it depends on everything and nothing depends on
    // it (no engine package statically imports a game; they reach it only by
    // runtime registration). It therefore sits ABOVE @chimera-engine/electron
    // (layer 2), not beside it. References mirror its composite workspace deps,
    // so `tsc --build` orders the graph (Invariant #1,
    // tools/tsconfig-build-graph.test.ts). The @chimera-engine/electron
    // reference mirrors the package dep the app's Electron composition root
    // (electron/main.ts) introduces; that composition root is EXCLUDED from this
    // composite's emit (it is bundled by `build:app` / electron/build-main.ts
    // and type-checked by the root flat `tsc --noEmit`), because a runnable
    // Electron main must be a single bundled file, not a tsc composite output.
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "composite": true,
        "noEmit": false,
        "rootDir": ".",
        "outDir": "./dist",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "tsBuildInfoFile": "./dist/.tsbuildinfo",
        "allowArbitraryExtensions": true,
        "jsx": "react-jsx",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["node", "react", "react-dom"]
    },
    "references": [
        { "path": "../../simulation/tsconfig.build.json" },
        { "path": "../../ai/tsconfig.build.json" },
        { "path": "../../renderer/tsconfig.build.json" },
        { "path": "../../electron/tsconfig.build.json" }
    ],
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": [
        "node_modules",
        "dist",
        "out",
        // The Electron composition root (electron/main.ts) imports
        // @chimera-engine/electron and belongs to the standalone app, not the
        // @chimera-engine/action library — keep it out of this composite build.
        "electron/**",
        // Reserved for the Playwright suite: test infrastructure is never library
        // source, and the pattern is inert until one lands here.
        "e2e/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/__tests__/**"
    ]
}
