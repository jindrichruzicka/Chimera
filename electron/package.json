{
    "name": "@chimera-engine/electron",
    "version": "1.0.0-rc.12",
    "description": "Electron main + preload host wrapper composing the Chimera engine into a desktop app.",
    "license": "MIT",
    "author": "Jindrich Ruzicka <ing.jindrich.ruzicka@gmail.com>",
    "homepage": "https://github.com/jindrichruzicka/Chimera#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jindrichruzicka/Chimera.git",
        "directory": "electron"
    },
    "bugs": "https://github.com/jindrichruzicka/Chimera/issues",
    "private": false,
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "bin": {
        "chimera-dev-mp": "dist/dev-tools/dev-harness/cli.js",
        "chimera-fetch-fonts": "dist/dev-tools/fetch-google-fonts/index.js",
        "chimera-generate-icons": "dist/dev-tools/generate-icons/index.js",
        "chimera-validate-assets": "dist/dev-tools/validate-assets/index.js"
    },
    "exports": {
        "./main": {
            "types": "./dist/main/index.d.ts",
            "default": "./dist/main/index.js"
        },
        "./dev-harness": {
            "types": "./dist/dev-tools/dev-harness/harness.d.ts",
            "default": "./dist/dev-tools/dev-harness/harness.js"
        },
        "./eslint": {
            "types": "./dist/dev-tools/eslint/index.d.ts",
            "default": "./dist/dev-tools/eslint/index.js"
        },
        "./test-support": {
            "types": "./dist/dev-tools/test-support/index.d.ts",
            "default": "./dist/dev-tools/test-support/index.js"
        },
        "./preload/api": {
            "types": "./dist/preload/api.d.ts",
            "default": "./dist/preload/api.js"
        },
        "./preload/api-types": {
            "types": "./preload/api-types.ts",
            "default": "./dist/preload/api-types.js"
        },
        "./preload/api-types.js": {
            "types": "./preload/api-types.ts",
            "default": "./dist/preload/api-types.js"
        },
        "./preload/debug-api-types": {
            "types": "./preload/debug-api-types.ts",
            "default": "./dist/preload/debug-api-types.js"
        },
        "./preload/debug-api-types.js": {
            "types": "./preload/debug-api-types.ts",
            "default": "./dist/preload/debug-api-types.js"
        },
        "./packaged-bundle": {
            "types": "./dist/packaged-bundle/index.d.ts",
            "default": "./dist/packaged-bundle/index.js"
        },
        "./build-main": {
            "types": "./dist/build-main/index.d.ts",
            "default": "./dist/build-main/index.js"
        }
    },
    "files": [
        "dist",
        "assets",
        "CHANGELOG.md",
        "preload/api-types.ts",
        "preload/debug-api-types.ts",
        "!dist/**/__test-support__/**"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "test": "vitest run --config ../vitest.config.mts --dir .",
        "lint": "eslint ."
    },
    "peerDependencies": {
        "@eslint/css": "^1.2.0",
        "@eslint/js": "^9.39.4",
        "electron": "^33.2.0",
        "eslint": "^9.39.4",
        "sharp": "^0.35.2"
    },
    "peerDependenciesMeta": {
        "@eslint/css": {
            "optional": true
        },
        "@eslint/js": {
            "optional": true
        },
        "electron": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "sharp": {
            "optional": true
        }
    },
    "dependencies": {
        "@chimera-engine/simulation": "workspace:*",
        "@chimera-engine/ai": "workspace:*",
        "@chimera-engine/networking": "workspace:*",
        "@chimera-engine/renderer": "workspace:*",
        "pino": "^10.3.1",
        "typescript": "^5.7.2",
        "zod": "^4.3.6"
    }
}
