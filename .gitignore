# E2E app bundles generated by each consumer app's e2e/global-setup.ts — not
# source, not committed. One root per suite: each setup deletes its own root
# wholesale on every run, so a shared one would remove the other's bundles.
.e2e-build/
.e2e-build-action/

# In-tree Electron bundle outputs (dev/manual launch via root `main`) — source
# lives in the adjacent .ts files. The ESM dist build (electron/dist, F62 #777) is
# the type/consumer-resolution surface; the runtime launch still uses these CJS
# bundles / the e2e esbuild bundle until the runtime composition lands (T2/T3).
electron/main/index.js
electron/preload/api.js

# Playwright output — generated artefacts, not source
apps/tactics/e2e/playwright-report/
apps/tactics/e2e/results/
apps/action/e2e/playwright-report/
apps/action/e2e/results/
test-results/

# electron-builder app-bundle output (apps/tactics, #813) — generated installers/bundles
apps/tactics/release/
